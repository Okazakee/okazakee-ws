# Public website environment (Okazakee/okazakee-ws)
# CMS environment lives in Okazakee/okazakee-cms/.env.local.example.

# Required - Get from Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only elevated key, currently used by the integrated CMS.
# Will be removed from this repo after the CMS decoupling cutover
# (see docs/cms-decoupling/pre-cutover-checklist.md).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DOMAIN_URL=http://localhost:3000

# Optional
# Application environment: production | staging | development.
# Controls cache defaults and publish-date enforcement on public reads.
# Defaults are derived from NODE_ENV when unset. On preview/staging deploys
# set APP_ENV=staging to keep the short-cache / future-posts-visible behavior.
APP_ENV=development

# Hide future-dated posts from public reads. Default: true in production
# builds (APP_ENV=production), false otherwise. Explicit value wins.
CONTENT_ENFORCE_PUBLISH_DATE=false

# Cache revalidation in seconds. Defaults: production 86400, otherwise 600.
ISR_REVALIDATION=86400

# When set, legacy /{locale}/cms* URLs redirect (307) to the standalone CMS
# host. Unset locally or for rollback to keep the integrated CMS serving.
LEGACY_CMS_REDIRECT_HOST=https://okazakee-cms.vercel.app

# Secret shared with the standalone CMS (WEBSITE_REVALIDATION_SECRET there).
# Authenticates content-change events on POST /api/internal/content-revalidate.
# Required once the CMS runs as a separate application.
CONTENT_REVALIDATION_SECRET=

# Public site URL (metadata/OG; invite links now use CMS_PUBLIC_URL in the CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UMAMI_ENABLED=false
NEXT_PUBLIC_LOCALES=en,it
NEXT_PUBLIC_DEFAULT_LOCALE=en
